[Unit]
Description=Llavero FIDO HID broker for UID %i
# Let a uhid entry in /etc/modules-load.d/ take effect first; the broker
# refuses to start without /dev/uhid.
After=systemd-modules-load.service

[Service]
Type=simple
ExecStart=/usr/lib/llavero/llavero-uhid --uid %i
RuntimeDirectory=llavero-uhid-%i
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=2
User=root
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=CAP_CHOWN
DevicePolicy=closed
DeviceAllow=/dev/uhid rw
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
# Filesystem Unix sockets still work across network namespaces.
PrivateNetwork=true
PrivateIPC=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictSUIDSGID=true
LockPersonality=true
LimitCORE=0

[Install]
WantedBy=multi-user.target
